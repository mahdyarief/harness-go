# App
# Debug logging prints every auth query with its values, password hashes
# included; it is refused when ENV=production.
DEBUG=false
# development, staging or production. Unset means production; only
# development relaxes the session cookie and the loopback rate limit.
ENV=development
PORT=8080
APP_NAME=hsg
APP_SECRET=

# Super user created on boot when SEED_ON_BOOT=true, as email:password.
# Set an individual password of 12 to 128 characters before enabling seeding. Changing it
# resets the account's password on the next seeded boot.
SUPER_USER=

# Comma-separated browser origins allowed to call the API cross-origin.
# Empty disables CORS (same-origin only).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Comma-separated client IPs that skip the rate limiter. Empty means every
# client is limited. Only useful behind a trusted proxy (see TRUSTED_PROXIES).
RATE_LIMIT_EXEMPT_IPS=
# Comma-separated IPs or CIDRs of the reverse proxy. The client IP used for
# rate limiting is the rightmost X-Forwarded-For entry that is not one of
# them. Leave empty when the API is not behind a proxy.
TRUSTED_PROXIES=

# Directory for original knowledge base files. Must be writable and persistent
# (a mounted volume in containers). Defaults to ./data/kb.
KB_STORAGE_DIR=./data/kb

# Apply embedded migrations when the API boots
MIGRATE_ON_BOOT=true
# Run the idempotent seeders when the API boots (needs SUPER_USER)
SEED_ON_BOOT=false

# Local development only: never use these credentials in production.
DB_DSN=postgres://postgres:postgres@localhost:5432/hsg?sslmode=disable
# Pool tenant wajib memakai role LOGIN non-owner, NOSUPERUSER, NOBYPASSRLS,
# NOCREATEROLE, NOCREATEDB, tanpa membership role istimewa.
# Siapkan role dan grant setelah migrasi; jangan gunakan role postgres di sini.
TENANT_DB_DSN=
# Kunci enkripsi credential platform: base64 dari 32 byte acak.
# Pisahkan dari APP_SECRET, simpan di secret manager saat deployment.
# Kosong berarti penyimpanan credential LLM tidak tersedia.
LLM_ENCRYPTION_KEY=
# Daftar host HTTPS persis, dipisahkan koma; tanpa URL, port atau wildcard.
# Kosong berarti seluruh koneksi provider ditolak.
LLM_ALLOWED_HOSTS=
# Worker opsional; role LOGIN terisolasi dengan membership hsg_embedding_worker.
# Kosong berarti worker tidak dijalankan.
EMBEDDING_WORKER_DB_DSN=
# Izin jaringan embedding terpisah dari provider LLM; kosong menolak semua host.
EMBEDDING_ALLOWED_HOSTS=
# Aktifkan hanya untuk endpoint self-hosted pada jaringan privat yang dipercaya.
EMBEDDING_ALLOW_PRIVATE=false
# Dipakai `migrate seed-embedding` untuk bootstrap satu kali: menulis profil
# BAAI/bge-m3 dan credential terenkripsi ke knowledge_embedding_config. Kosong
# berarti bootstrap dilewati; konfigurasi tetap bisa diisi lewat API admin.
EMBEDDING_ENDPOINT=
EMBEDDING_REVISION=
# Harus sama dengan EMBEDDING_API_KEY yang dipegang service embedding.
EMBEDDING_API_KEY=
# Per replica, split in half between the API pool and Authula's.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m

# Auth (Authula, mounted at /api/v1/auth). APP_SECRET also signs Authula tokens.
# Public URL of this API, used in email links and the Google callback;
# empty defaults to http://localhost:$PORT.
AUTH_BASE_URL=http://localhost:8080
# Resend sender (must be a verified domain) and API key
FROM_ADDRESS=noreply@example.com
RESEND_API_KEY=
# Google OAuth client; empty disables Google sign-in. Authorized redirect URI:
# $AUTH_BASE_URL/api/v1/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENTRY_DSN=
