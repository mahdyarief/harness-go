ENV=staging
DEBUG=false
PORT=8080
APP_NAME=hsg
MIGRATE_ON_BOOT=false
SEED_ON_BOOT=false
APP_SECRET=replace-with-base64-random-secret
SUPER_USER=
LLM_ENCRYPTION_KEY=replace-with-base64-32-byte-key
CORS_ALLOWED_ORIGINS=https://hsg.example.com
TRUSTED_PROXIES=172.16.0.0/12
RATE_LIMIT_EXEMPT_IPS=
AUTH_BASE_URL=https://api-hsg.example.com
FROM_ADDRESS=noreply@example.com
RESEND_API_KEY=replace-with-your-resend-api-key
LLM_ALLOWED_HOSTS=api.openai.com

# --- Embedding self-hosted (BGE-M3) ---
# Paket deploy ini menjalankan service embedding sendiri di jaringan compose.
# Revision dipin ke commit 40-hex; jangan diganti tanpa mengunduh ulang model
# ke volume embedding_cache dan menjalankan ulang bootstrap konfigurasi.
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_API_KEY=replace-with-32-printable-ascii-characters
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_WORKER_DB_PASSWORD=replace-with-a-different-random-password
EMBEDDING_WORKER_DB_DSN=postgres://hsg_embedding_worker:replace-with-a-different-random-password@db:5432/hsg?sslmode=disable
EMBEDDING_ALLOWED_HOSTS=embedding
EMBEDDING_ALLOW_PRIVATE=true
# Embedding tetap nonaktif sampai endpoint dan revision self-hosted tervalidasi.
EMBEDDING_WORKER_DB_DSN=
EMBEDDING_ALLOWED_HOSTS=
EMBEDDING_ALLOW_PRIVATE=false
