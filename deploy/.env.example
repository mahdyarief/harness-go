POSTGRES_PASSWORD=replace-with-a-random-database-password
TENANT_DB_PASSWORD=replace-with-a-different-random-password
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# --- Self-hosted embedding (BGE-M3) ---
# Kunci ini dipakai interpolasi compose dan scripts/init-db.sh; nilai
# EMBEDDING_API_KEY harus identik dengan yang ada di hsg.env.
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_API_KEY=replace-with-32-printable-ascii-characters
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_WORKER_DB_PASSWORD=replace-with-a-different-random-password
